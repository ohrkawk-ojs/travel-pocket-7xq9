---
import TravelLayout from '../../../layouts/TravelLayout.astro';
import ScheduleTimeline from '../../../components/ScheduleTimeline.astro';
import { travelSchedule } from '../../../data/travel-schedule';
const base = import.meta.env.BASE_URL;
---
<TravelLayout title="전체 일정 — Travel Pocket">
  <main class="page">
    <section class="hero compact">
      <div class="section-label">SCHEDULE</div>
      <h1>전체 일정</h1>
      <p>날짜별 일정을 정리하고, 장소가 있는 일정은 지도와 길찾기로 바로 연결합니다.</p>
      <a class="wide-button" href={`${base}t/2026-main-8k3p/`}>← 링크북으로 돌아가기</a>
    </section>
    <ScheduleTimeline days={travelSchedule} />
  </main>
</TravelLayout>
